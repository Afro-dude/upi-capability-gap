# Optional locally: without MONGODB_URI a real MongoDB process starts automatically.
# Its files persist in web/.local/mongo-data. First startup downloads MongoDB.
# Required for deployment (keep real credentials out of Git):
# MONGODB_URI=mongodb://127.0.0.1:27017/upi
# NODE_ENV=production
# APP_ORIGIN=https://your-app.example
# HOST=0.0.0.0
PORT=3000
