{
  "name": "upi-capability-observatory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js --dev",
    "build": "vite build --config vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "import:data": "node --env-file-if-exists=.env server/import.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "format": "prettier --write server client tests vite.config.js package.json README.md"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "graphql": "^17.0.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.47.0",
    "mongoose": "^9.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "mongodb-memory-server-core": "^11.3.0",
    "prettier": "^3.9.8",
    "vite": "^8.3.0"
  }
}
