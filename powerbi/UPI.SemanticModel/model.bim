      {
        "name": "_Measures",
        "lineageTag": "81c1c005-ea9c-5633-b70b-6e7b0252c7e1",
        "columns": [
          {
            "name": "placeholder",
            "dataType": "double",
            "sourceColumn": "placeholder",
            "summarizeBy": "none",
            "lineageTag": "b446ed34-bb92-5f1a-b256-44f2626174b8",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Rows = Json.Document(Binary.Decompress(Binary.FromText(\"i4420DOIjQUA\", BinaryEncoding.Base64), Compression.Deflate)),",
                "    Data = Table.FromRows(Rows, {\"placeholder\"}),",
                "    Typed = Table.TransformColumnTypes(Data, {{\"placeholder\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Adults",
            "expression": "SUM(fct_segment[adults])",
            "lineageTag": "05ccab3b-bfc3-53f5-bd8c-bffeee843a90",
            "formatString": "#,0"
          },
          {
            "name": "Capable Adults",
            "expression": "SUM(fct_segment[capable_adults])",
            "lineageTag": "20c91090-fdc3-5bed-91db-006461fee487",
            "formatString": "#,0"
          },
          {
            "name": "Excluded Adults",
            "expression": "[Adults] - [Capable Adults]",
            "lineageTag": "a9fab62b-a976-57d5-bc7b-92e9b34fcb51",
            "formatString": "#,0"
          },
          {
            "name": "Capability Rate",
            "expression": "DIVIDE([Capable Adults], [Adults])",
            "lineageTag": "38543df9-5371-56c8-9841-0db488f6f3ab",
            "formatString": "0.0%"
          },
          {
            "name": "Sample Size",
            "expression": "SUM(fct_segment[sample_n])",
            "lineageTag": "b786cf29-1303-5db4-941a-2b750600a71d",
            "formatString": "#,0"
          },
          {
            "name": "Displayed Capability Rate",
            "expression": "IF([Sample Size] >= 30, [Capability Rate], BLANK())",
            "lineageTag": "7db39820-c2b2-5d39-8d61-406142bdf1af",
            "formatString": "0.0%"
          },
          {
            "name": "Adults (crore)",
            "expression": "DIVIDE([Adults], 10000000)",
            "lineageTag": "414c6975-f8d9-599b-9bca-2cb035fc17dc",
            "formatString": "0.0"
          },
          {
            "name": "Excluded (crore)",
            "expression": "DIVIDE([Excluded Adults], 10000000)",
            "lineageTag": "0dc55d8d-1e04-58d8-9ba4-cf84046363dc",
            "formatString": "0.0"
          },
          {
            "name": "Internet users unable to bank online (crore)",
            "expression": "DIVIDE(SUM(fct_conditional_national[internet_users_not_online_capable]),10000000)",
            "lineageTag": "fc9da80a-b291-5769-bd31-c067aaf3b33a",
            "formatString": "0.0"
          },
          {
            "name": "Indicator Share",
            "expression": "SELECTEDVALUE(fct_funnel[share_of_adults])",
            "lineageTag": "fe6c7450-024c-5c55-b6e4-7794fac076f0",
            "formatString": "0.0%"
          },
          {
            "name": "Households without internet",
            "expression": "SUM(fct_barriers[households])",
            "lineageTag": "3b6fd3f8-c01f-5e8a-a42c-81adc33c9679",
            "formatString": "#,0"
          },
          {
            "name": "Barrier Share",
            "expression": "DIVIDE([Households without internet], CALCULATE([Households without internet], REMOVEFILTERS(fct_barriers[reason]), REMOVEFILTERS(fct_barriers[barrier_group])))",
            "lineageTag": "ffcba756-f02d-5bed-9032-4199e6ba0553",
            "formatString": "0.0%"
          },
          {
            "name": "National Transactions (bn)",
            "expression": "SUM(fct_npci_national[total_volume_mn])/1000",
            "lineageTag": "a6a719f9-1745-5ebc-9892-764240b0eda5",
            "formatString": "0.00"
          },
          {
            "name": "Classified Transactions (bn)",
            "expression": "SUM(fct_npci_national[classified_volume_mn])/1000",
            "lineageTag": "0003fbb7-9125-559c-867d-cd281a68573a",
            "formatString": "0.00"
          },
          {
            "name": "Unclassified Transactions (bn)",
            "expression": "SUM(fct_npci_national[unclassified_volume_mn])/1000",
            "lineageTag": "e7212f59-08eb-5837-946e-089fb1661f3f",
            "formatString": "0.00"
          },
          {
            "name": "Unclassified Share",
            "expression": "DIVIDE(SUM(fct_npci_national[unclassified_volume_mn]),SUM(fct_npci_national[total_volume_mn]))",
            "lineageTag": "a48d64a7-8926-5fb4-af7f-a27afc6cbd7d",
            "formatString": "0.0%"
          },
          {
            "name": "State Capability Rate",
            "expression": "DIVIDE(SUM(fct_state[capable_adults]),SUM(fct_state[adults]))",
            "lineageTag": "661a31d7-2e14-5a77-b55b-a21ca78781c2",
            "formatString": "0.0%"
          },
          {
            "name": "Classified Transactions per Resident 15+",
            "expression": "DIVIDE(SUM(fct_state[txn_volume_mn])*1000000,SUM(fct_state[adults]))",
            "lineageTag": "1e8c7b59-f513-55ef-a7e0-98b9a8d4f9f5",
            "formatString": "0.0"
          },
          {
            "name": "State Review",
            "expression": "IF(HASONEVALUE(dim_state[state]), SELECTEDVALUE(fct_state[review_status]), \"Select a state to see its source check\")",
            "lineageTag": "b4fad2b1-e98f-51cd-9965-dac7fcf79250"
          },
          {
            "name": "Source Check",
            "expression": "IF(HASONEVALUE(dim_state[state]), SELECTEDVALUE(fct_state[review_status]), \"See Methods for source checks\")",
            "lineageTag": "1890f89e-30d2-5dd9-bf64-a7abd81823f0"
          },
          {
            "name": "Assumed Share",
            "expression": "DIVIDE(SELECTEDVALUE(scenario[assumed_percent],10),100)",
            "lineageTag": "fb4ac675-3011-5642-a330-26773cd63483",
            "formatString": "0%"
          },
          {
            "name": "Scenario Baseline",
            "expression": "IF([Sample Size] >= 30, [Excluded Adults], BLANK())",
            "lineageTag": "12a6ab0f-68e6-5fb4-bd91-1f4a49d1fb54",
            "formatString": "#,0"
          },
          {
            "name": "Newly Capable (what-if)",
            "expression": "[Scenario Baseline] * [Assumed Share]",
